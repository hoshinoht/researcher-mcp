# Google Scholar pacing and retries (Scholar only; APIs use the intervals below)
SCHOLAR_MIN_DELAY=3
SCHOLAR_MAX_DELAY=8
SCHOLAR_MAX_RETRIES=5
SCHOLAR_BACKOFF_FACTOR=2.0
SCHOLAR_ROTATE_USER_AGENTS=true
SCHOLAR_USER_AGENTS=
SCHOLAR_PROXY_LIST=
SCHOLAR_TIMEOUT_SECONDS=25

# Per-host pacing for structured APIs (OpenAlex, Crossref, ORCID, Unpaywall)
# and for every other host (publishers, repositories, arXiv), in milliseconds.
RESEARCHER_API_MIN_INTERVAL_MS=150
RESEARCHER_DOCUMENT_MIN_INTERVAL_MS=1000
# Longest Retry-After the server will wait out; longer waits fail fast.
RESEARCHER_MAX_RETRY_AFTER_SECONDS=30
# Deadline for one whole tool call (all providers, retries and extraction).
RESEARCHER_OPERATION_TIMEOUT_SECONDS=120

# Article search provider order: any of openalex, crossref, scholar.
# Default: openalex,crossref,scholar when OPENALEX_API_KEY is set,
# otherwise scholar,openalex,crossref.
RESEARCHER_SEARCH_PROVIDERS=
# Tool catalog: all (default: legacy names + preferred aliases), preferred, legacy.
RESEARCHER_TOOL_SET=all

# Full-text extraction (get_paper_fulltext / read_research_paper)
# Contact email: required by Unpaywall (enables that fallback) and sent to
# Crossref as mailto (polite pool). It is not sent to OpenAlex.
SCHOLAR_CONTACT_EMAIL=
# Max document (PDF/HTML) download size in MB (default 30).
SCHOLAR_MAX_FETCH_MB=30
# Max API/HTML response size in MB for metadata calls (default 8).
RESEARCHER_MAX_RESPONSE_MB=8
# Max characters kept from one extracted document (default 2000000).
RESEARCHER_MAX_EXTRACT_CHARS=2000000
# Memory budget for cached extracted documents in MB (default 64).
RESEARCHER_CACHE_MAX_MB=64
# Path to poppler's pdftotext binary; empty = auto-detect on PATH, "off" = pure-Go extraction only.
SCHOLAR_PDFTOTEXT_PATH=

# Provider credentials (optional). Each is sent only to its own provider over HTTPS.
# OpenAlex: free API key (sent as the api_key query parameter). Strongly
# recommended: keyless OpenAlex use has a very small daily budget.
OPENALEX_API_KEY=
# Crossref Metadata Plus token (paid; sent as "Crossref-Plus-API-Token: Bearer ...").
# Not needed for normal use: Crossref's public/polite pools need no key.
CROSSREF_API_KEY=
# ORCID public API client credentials (free registration); exchanged for a
# /read-public token. Without them ORCID is queried anonymously.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
